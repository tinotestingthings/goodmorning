{
  "name": "goodmorning-explainer",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion explainer: how knowledge flows through the goodmorning ecosystem",
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion render EcosystemExplainer out/ecosystem-explainer.mp4 --codec=h264",
    "build:gif": "remotion render EcosystemExplainer out/ecosystem-explainer.gif --codec=gif --every-nth-frame=2",
    "still": "remotion still EcosystemExplainer out/frame.png",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/google-fonts": "4.0.290",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@types/react": "19.0.0",
    "typescript": "5.6.3"
  }
}
